  {
    "name": "thinking_removes_thinking_and_signature_fields",
    "body": "{\"model\":\"claude-test\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"t\",\"signature\":\"sig_thinking\"},{\"type\":\"text\",\"text\":\"hello\",\"signature\":\"sig_text_should_remove\"},{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"WebSearch\",\"input\":{\"query\":\"q\"},\"signature\":\"sig_tool_should_remove\"},{\"type\":\"redacted_thinking\",\"data\":\"r\",\"signature\":\"sig_redacted\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}]}",
    "ops": [
      {
        "op": "apply_thinking_signature_rectifier"
      }
    ],
    "expectedBody": "{\"model\":\"claude-test\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hello\"},{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"WebSearch\",\"input\":{\"query\":\"q\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}]}",
    "expectedOpResults": {
      "thinkingSignature": {
        "applied": true,
        "removedThinkingBlocks": 1,
        "removedRedactedThinkingBlocks": 1,
        "removedSignatureFields": 2,
        "removedTopLevelThinking": false
      }
    }
  },
